                "rules": [
                    {
                        "description": "Caps Lock -> Escape (alone); Shift+Caps -> Caps Lock",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": {
                                        "mandatory": [
                                            "shift"
                                        ],
                                        "optional": [
                                            "caps_lock"
                                        ]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "caps_lock",
                                        "hold_down_milliseconds": 200
                                    }
                                ]
                            },
                            {
                                "type": "basic",
